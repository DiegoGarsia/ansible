# {{ ansible_managed }}
# GitLab Omnibus configuration for gitlab-clarity (2 vCPU / 4 GB RAM)
# Managed by Ansible — do not edit manually.

external_url '{{ gitlab_clarity_external_url }}'
registry_external_url '{{ gitlab_clarity_registry_external_url }}'

# ---------------------------------------------------------------------------
# TLS / HTTPS — wildcard certificate from the lab internal CA.
# Certificate and key are delivered to the VM by tasks/tls.yml (Stage 1).
# ---------------------------------------------------------------------------
nginx['ssl_certificate'] = '{{ gitlab_clarity_tls_cert_path }}'
nginx['ssl_certificate_key'] = '{{ gitlab_clarity_tls_key_path }}'

# Keep HTTP on port 80 available during the transition; no auto redirect.
nginx['redirect_http_to_https'] = false

# ---------------------------------------------------------------------------
# Container Registry
# ---------------------------------------------------------------------------
gitlab_rails['registry_enabled'] = {{ gitlab_clarity_registry_enabled | bool | lower }}
registry_nginx['ssl_certificate'] = '{{ gitlab_clarity_tls_cert_path }}'
registry_nginx['ssl_certificate_key'] = '{{ gitlab_clarity_tls_key_path }}'

# ---------------------------------------------------------------------------
# Let's Encrypt (disabled — self-signed lab CA, no public domain)
# ---------------------------------------------------------------------------
letsencrypt['enable'] = {{ gitlab_clarity_letsencrypt_enabled | bool | lower }}

{% if gitlab_clarity_resource_optimization | bool %}
# ---------------------------------------------------------------------------
# Resource optimization for 2 vCPU / 4 GB RAM VM
# ---------------------------------------------------------------------------

# Disable monitoring stack to conserve RAM
prometheus['enable'] = false
alertmanager['enable'] = false
node_exporter['enable'] = false
redis_exporter['enable'] = false
postgres_exporter['enable'] = false
gitlab_exporter['enable'] = false

# Disable GitLab Kubernetes Agent Server (not needed without Kubernetes integration)
gitlab_kas['enable'] = false

# Puma — 2 workers for 2 vCPU
puma['worker_processes'] = {{ gitlab_clarity_puma_worker_processes }}

# Sidekiq — limit concurrency for 4 GB RAM
sidekiq['max_concurrency'] = {{ gitlab_clarity_sidekiq_max_concurrency }}
{% endif %}